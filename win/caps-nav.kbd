;; caps-nav.kbd — Kanata port of caps-nav.ahk
;;
;; Hold CapsLock as a momentary navigation layer (CapsLock's own toggle is
;; disabled — it never sends capslock). While CapsLock is held:
;;
;;   h j k l  -> Left Down Up Right
;;   a e      -> Home End
;;   p n      -> PageUp PageDown
;;   g t      -> `  (grave)  and  ~ (tilde)
;;   bspc     -> Delete (forward delete)
;;   c        -> a real capslock keypress (see below)
;;
;; CapsLock+c is the escape hatch for a stuck CapsLock. Because the CapsLock key
;; itself is the layer key it never emits capslock, so if the OS toggle latches
;; ON while kanata is not intercepting — during a restart, before the logon task
;; fires, or on the UAC/lock secure desktop — the physical key cannot clear it.
;; CapsLock+c sends the keypress that does. (PowerShell equivalent: `caps`.)
;;
;; Backspace keeps the normal Windows delay and repeat rate, both on its own and
;; as Caps+Backspace, the same as every other typing key.
;;
;; Why Kanata is steadier than the AHK #HotIf layer: Kanata tracks, per physical
;; key, which output key it is currently holding. Once you press CapsLock+l it
;; emits Right and keeps emitting Right until *l* is physically released — even
;; if you lift CapsLock first. So the held-key auto-repeat can no longer leak a
;; literal 'l' the way the polled GetKeyState layer did.
;;
;; CUSTOM REPEAT RATE: the movement keys (arrows, PgUp/PgDn) do NOT rely
;; on the Windows auto-repeat rate (which the OS slider caps at ~31/sec). Instead
;; they use `macro-repeat-release-cancel`, which fires the key once immediately
;; then re-fires it every $rr milliseconds while held, cancelling the instant you
;; let go. Tune the speed by changing $rr in the defvar below (smaller = faster).
;;
;; Run on Windows:
;;   kanata.exe --cfg caps-nav.kbd
;; To also reach elevated windows (admin terminals, Task Manager), start it
;; from an elevated shell / as administrator, same as the AHK RunAs block.
;;
;; Emergency quit chord (physical keys, before remapping): LCtrl + Space + Esc.

(defcfg
  ;; All keys we drive are listed in defsrc, so no extra options are required.
  ;; process-unmapped-keys stays at its default (off) so normal typing on every
  ;; other key is passed straight through, untouched.
  concurrent-tap-hold yes
)

;; Timing knobs in milliseconds. Live-reload picks up changes instantly.
;;   30 ~= 33 reps/sec   20 ~= 50 reps/sec   15 ~= 66 reps/sec   10 ~= 100 reps/sec
;;   rr = repeat gap for nav movement keys, once fast-repeat has kicked in.
;;   hh = nav-key "halt": the INITIAL DELAY, i.e. how long a key must be held
;;        before fast-repeat starts. A quick tap under this stays a single
;;        keypress; bigger = longer pause before the key starts machine-gunning.
;;        For reference Windows' own auto-repeat delay is ~500ms here
;;        (HKCU\Control Panel\Keyboard\KeyboardDelay = 1), so $hh is deliberately
;;        a little snappier than the OS without being twitchy.
(defvar
  rr 20
  hh 400
)

;; Physical keys this config intercepts. Order here must line up column-for-column
;; with every deflayer below. Any key NOT listed is passed straight to the OS.
(defsrc
  caps   a     e     g     h     j     k      l      n      p      t      bspc   c
)

;; Base layer: CapsLock becomes the layer key; every other key is itself.
(deflayer base
  @nav   a     e     g     h     j     k      l      n      p      t      bspc   c
)

;; Navigation layer, active only while CapsLock is held.
;; caps is transparent (_) here so the held layer key keeps working.
;; Arrows (hjkl) and page keys (p/n) all follow the OS repeat shape: the key
;; fires once immediately on press, then waits $hh before the fast repeat at $rr
;; takes over. Delete, Home/End and grave/tilde stay plain taps (grave/tilde
;; must not spam) and so use the Windows repeat delay/rate.
;; c emits a real capslock so a stuck OS toggle can be cleared from the keyboard.
(deflayer nav
  _      home  end   grv   @fh   @fj   @fk    @fl    @fn    @fp    S-grv  del    caps
)

(defalias
  ;; Hold CapsLock -> nav layer; tapping it alone does nothing (toggle disabled).
  nav (layer-while-held nav)

  ;; Fast-repeat cores: fire once immediately, then every $rr ms while held;
  ;; the release-cancel variant stops the instant the key is let go.
  rh  (macro-repeat-release-cancel left  $rr)
  rj  (macro-repeat-release-cancel down  $rr)
  rk  (macro-repeat-release-cancel up    $rr)
  rl  (macro-repeat-release-cancel right $rr)

  ;; Arrow keys (Caps+hjkl). A bare tap-hold emits nothing on press: the tap
  ;; action only lands on release, so holding the key showed no initial move at
  ;; all. These now follow the OS shape instead - one arrow immediately on press,
  ;; then silence until the key has been held $hh ms, then the fast repeat at
  ;; $rr. The (macro left) sends the first arrow, so the tap-hold's tap action is
  ;; XX: a quick tap has already produced its keypress and must not double up.
  fh  (multi (macro left)  (tap-hold $hh $hh XX @rh))
  fj  (multi (macro down)  (tap-hold $hh $hh XX @rj))
  fk  (multi (macro up)    (tap-hold $hh $hh XX @rk))
  fl  (multi (macro right) (tap-hold $hh $hh XX @rl))

  ;; Page keys (Caps+p/n). These used to fire instantly and then repeat with no
  ;; halt at all, so a single press easily emitted several pages. They now send
  ;; one page immediately, stay quiet until the key has been held $hh ms, and
  ;; only then hand over to the fast repeat at $rr - the same shape as the OS
  ;; delay/rate pair. The (macro pgdn) sends the key itself, so the tap-hold's
  ;; tap action is XX: the keypress has already gone out.
  rn  (macro-repeat-release-cancel pgdn  $rr)
  rp  (macro-repeat-release-cancel pgup  $rr)
  fn  (multi (macro pgdn) (tap-hold $hh $hh XX @rn))
  fp  (multi (macro pgup) (tap-hold $hh $hh XX @rp))
)
